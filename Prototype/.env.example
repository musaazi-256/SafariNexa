# Postgres connection string (Prisma). Deliberately named with a project
# prefix instead of the Prisma-conventional bare DATABASE_URL, to avoid
# colliding with that name if this app ever shares a hosting environment
# with other services/tooling that assume the generic default.
SAFARINEXA_PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/safarinexa"

# Auth.js / NextAuth v5. AUTH_URL should match where the app is served from;
# AUTH_SECRET must be a long random string (e.g. `openssl rand -base64 32`).
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
# Kept for tooling that still reads the v4 names — same values as above.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth. One Google Cloud OAuth client is reused for two NextAuth
# provider ids (customer/business "google" and the stricter admin
# "google-admin"), so register BOTH redirect URIs on the same client:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google-admin
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo mode is enabled by default, including hosted builds. Set false for live operation.
SAFARINEXA_DEMO_MODE="true"

# Legacy development flag (demo mode now controls demo access).
AUTH_DEV_MODE="false"

# Stripe hosted checkout and signed webhooks. Live mode only. Demo payments need no keys.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Account email delivery. Blank keys explicitly disable email requests.
EMAIL_FROM=""
RESEND_API_KEY=""
SMS_PROVIDER_API_KEY=""

# Required in production: private persistent volume outside public/.
PRIVATE_DOCUMENT_DIRECTORY=""
PUBLIC_IMAGE_DIRECTORY=""

# Protects POST /api/jobs/expire-bookings. Schedule in deployment infrastructure.
CRON_SECRET=""

# Postgres connection string (Prisma).
SAFARINEXA_PRISMA_DATABASE_URL="postgresql://user:password@localhost:5432/safarinexa"

# Auth.js / NextAuth v5. AUTH_URL should match where the app is served from;
# AUTH_SECRET must be a long random string (e.g. `openssl rand -base64 32`).
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
# Kept for tooling that still reads the v4 names — same values as above.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth. One Google Cloud OAuth client is reused for two NextAuth
# provider ids (customer/business "google" and the stricter admin
# "google-admin"), so register BOTH redirect URIs on the same client:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google-admin
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# DEV ONLY. When "true", email/password sign-in on every surface (customer,
# business, admin) accepts ANY email/password and auto-provisions the
# account (including an ACTIVE AdminUser for the admin form) so you can test
# without seeding or configuring Google OAuth. Never set this in production.
AUTH_DEV_MODE="false"

# Payments — Flutterwave (mobile money + card). Leave blank to run the
# payment flow in simulated/placeholder mode.
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Email/SMS notification abstraction — leave blank to log notifications only.
EMAIL_FROM=""
RESEND_API_KEY=""
SMS_PROVIDER_API_KEY=""
